---
import Hero from "../components/Hero.astro";
import Navbar from "../components/Navbar.astro";
import About from "../components/About.astro";
import Skills from "../components/Skills.astro";
import Portfolio from "../components/Portfolio.astro";
import ContactSection from "../components/ContactSection.tsx";
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
import { SEO } from "astro-seo";
---

<Layout title="Afra Hanifi | Fullstack Dev Portfolio">
  <SEO
    slot="head"
    title="Afra Hanifi - Fullstack Developer"
    description="Indonesian Dev Specializing on Web App"
    openGraph={{
      basic: {
        title: "Afra Hanifi - Fullstack Developer",
        type: "website",
        image: "https://portfolio.tableworks.my.id/profilepic.png",
        url: "https://portfolio.tableworks.my.id",
      },
      optional: {
        siteName: "Tableworks",
        description:"Indonesian Dev Specializing on Web App"
      },
    }}
    twitter={{
      card: "summary_large_image",
    }}
  />
  <Navbar />
  <Hero />
  <About />
  <Skills />
  <Portfolio />
  <ContactSection client:load />
  <Footer />
</Layout>
